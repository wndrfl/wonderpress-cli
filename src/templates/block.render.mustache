<?php
/**
 * Server render for the `{{ namespace }}/{{ slug }}` block.
 *
 * A block is only an editor wrapper — the {{ class_name }} partial owns the
 * markup. This file delegates to it so there is a single source of HTML.
 * Generated by wonderpress-cli.
 *
 * The wrapping element carries WordPress's generated block attributes: the
 * `wp-block-{{ namespace }}-{{ slug }}` class, alignment, the anchor, and
 * anything future block supports contribute. Without it the block renders as
 * markup WordPress cannot recognise or target.
 *
 * It sits OUTSIDE the partial on purpose. Abstract_Partial::render() runs its
 * output through wp_kses(), whose CSS filtering would strip the custom
 * properties WordPress writes into the style attribute — so the wrapper is
 * echoed here, where nothing re-sanitises it.
 *
 * @package Wonderpress Theme
 *
 * @var array    $attributes Block attributes (map 1:1 to the partial properties).
 * @var string   $content    Inner block content.
 * @var WP_Block $block      Block instance.
 */

use Wonderpress\Partials\{{ class_name }};

/*
 * A partial throws when a required property is missing, which is correct for
 * PHP callers: `new {{ class_name }}( [] )` in a template is a mistake worth
 * hearing about. A block is different. Its values come from a person filling in
 * a form, so "not filled in yet" is the state EVERY block is in the moment it
 * is inserted — not an error. Left to throw, the editor shows "Error loading
 * block" before the author can type anything, and a required property makes a
 * block impossible to use at all.
 */
try {
	$partial = new {{ class_name }}( $attributes );
	$html    = $partial->render( false );
} catch ( \Throwable $e ) {

	// On the front end, an incomplete block renders nothing. It should never
	// take down the page around it.
	if ( ! defined( 'REST_REQUEST' ) || ! REST_REQUEST ) {
		return;
	}

	// In the editor, say what is missing — the author is the one who can fix it.
	$html = sprintf(
		'<p style="margin:0;padding:1em;border:1px dashed currentColor;opacity:.6">%s</p>',
		esc_html( $e->getMessage() )
	);
}

// get_block_wrapper_attributes() returns attributes WordPress has already
// escaped; $html is kses-filtered by Abstract_Partial, or built above.
printf(
	'<div %s>%s</div>',
	get_block_wrapper_attributes(), // phpcs:ignore WordPress.Security.EscapeOutput.OutputNotEscaped
	$html // phpcs:ignore WordPress.Security.EscapeOutput.OutputNotEscaped
);
