<?php
/**
 * Server render for the `wonderpress/{{ slug }}` block.
 *
 * A block is only an editor wrapper — the {{ class_name }} partial owns the
 * markup. This file delegates to it so there is a single source of HTML.
 * Generated by wonderpress-cli.
 *
 * The wrapping element carries WordPress's generated block attributes: the
 * `wp-block-wonderpress-{{ slug }}` class, alignment, the anchor, and anything
 * future block supports contribute. Without it the block renders as markup
 * WordPress cannot recognise or target.
 *
 * It sits OUTSIDE the partial on purpose. Abstract_Partial::render() runs its
 * output through wp_kses(), whose CSS filtering would strip the custom
 * properties WordPress writes into the style attribute — so the wrapper is
 * echoed here, where nothing re-sanitises it.
 *
 * @package Wonderpress Theme
 *
 * @var array    $attributes Block attributes (map 1:1 to the partial properties).
 * @var string   $content    Inner block content.
 * @var WP_Block $block      Block instance.
 */

use Wonderpress\Partials\{{ class_name }};

$partial = new {{ class_name }}( $attributes );

// get_block_wrapper_attributes() returns attributes WordPress has already
// escaped; Abstract_Partial::__toString() returns kses-filtered HTML.
printf(
	'<div %s>%s</div>',
	get_block_wrapper_attributes(), // phpcs:ignore WordPress.Security.EscapeOutput.OutputNotEscaped
	$partial // phpcs:ignore WordPress.Security.EscapeOutput.OutputNotEscaped
);
