{
  "name": "@wndrfl/wonderpress-cli",
  "version": "2.12.1",
  "description": "CLI for Wonderpress: bootstrap WordPress environments and author themes from manifests.",
  "main": "./bin/wonderpress.js",
  "type": "module",
  "repository": "github:wndrfl/wonderpress-cli",
  "bin": {
    "wonderpress": "bin/wonderpress.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "test": "node --test \"tests/**/*.test.js\"",
    "test:integration": "WP_INTEGRATION=1 node --test \"tests/**/*.test.js\"",
    "test:e2e": "WP_E2E=1 node --test tests/lifecycle.e2e.test.js",
    "test:e2e:wp-env": "WP_E2E=1 WP_BACKEND=wp-env node --test tests/lifecycle.e2e.test.js",
    "test-cli": "rm -rf test && mkdir test && cd test && npm install .. && node ../bin/wonderpress.js init --name test-project"
  },
  "files": [
    "bin/",
    "manifest/",
    "src/"
  ],
  "keywords": [
    "wonderpress",
    "wordpress",
    "cli",
    "gutenberg",
    "mcp",
    "theme"
  ],
  "author": "Johnnie Munger",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@wndrfl/static-kit-cli": "^2.13.0",
    "arg": "^5.0.2",
    "fs-extra": "^11.2.0",
    "inquirer": "^9.3.8",
    "mustache": "^4.2.0",
    "mysql2": "^3.24.4",
    "open": "^9.1.0",
    "picocolors": "^1.1.1",
    "rc": "^1.2.8",
    "shelljs": "^0.10.0",
    "sqlstring": "^2.3.3",
    "zod": "^4.6.5"
  },
  "overrides": {
    "braces": "3.0.3",
    "micromatch": "4.0.8",
    "picomatch@2": "2.3.2",
    "qs": "6.16.0",
    "sharp": "0.35.4",
    "esbuild": "^0.25.12"
  }
}
